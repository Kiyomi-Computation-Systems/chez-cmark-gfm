#!/bin/sh
# Runs INSIDE the pinned container: `make check-guix` is
#   sh tests/guix-env-launcher.sh && scripts/guix-env sh scripts/check-guix-env
# Asserts the two properties the environment exists for (spec §4), then
# runs the targets. Each failure names its assertion.
set -u

if [ -z "${GUIX_ENVIRONMENT:-}" ]; then
  echo "check-guix: FAILED not-in-environment: run this through make check-guix" >&2
  exit 2
fi

fail=0
out=$(mktemp)

if ! make build >"$out" 2>&1; then
  cat "$out"
  echo "check-guix: FAILED make-build" >&2
  exit 1
fi
cat "$out"

# Assertion 1: the library came from the store. A missing line yields an
# empty path, which fails the same way.
for role in core ext; do
  p=$(sed -n "s/^  $role: *//p" "$out")
  case "$p" in
    /gnu/store/*) echo "check-guix: ok store-library ($role: $p)" ;;
    *) echo "check-guix: FAILED store-library: $role is '$p', expected a /gnu/store/ path" >&2
       fail=1 ;;
  esac
done

# Assertion 2: however a shell here finds a tool, it runs the pinned
# binary. -lc and -lic are login shells, both forms since rc files branch
# on $-. fhs-first is the PATH order Claude Code's Bash tool was seen to use
# (/bin:/usr/bin ahead of the profile). Under --emulate-fhs those are the
# profile's own files, so the comparison is by resolved binary, not by
# prefix: /bin/scheme is the pinned scheme, and a host or guix-home copy
# that is a different store item is not.
for mode in -lc -lic fhs-first; do
  for tool in scheme make git cmark-gfm; do
    if [ "$mode" = fhs-first ]; then
      p=$(PATH="/bin:/usr/bin:/sbin:/usr/sbin:$PATH" bash -c "command -v $tool" 2>/dev/null | tail -n 1)
    else
      p=$(bash "$mode" "command -v $tool" 2>/dev/null | tail -n 1)
    fi
    want=$(readlink -f "$GUIX_ENVIRONMENT/bin/$tool")
    got=
    if [ -n "$p" ]; then
      got=$(readlink -f "$p")
    fi
    if [ -n "$got" ] && [ "$got" = "$want" ]; then
      echo "check-guix: ok tool-path[$mode] ($tool: $p)"
    else
      echo "check-guix: FAILED tool-path[$mode]: $tool resolves to '${got:-nothing}' (via '${p:-nothing}'), expected $want" >&2
      fail=1
    fi
  done
done

# Assertion 3: the Makefile's $(CHEZ) is the pinned Chez binary itself. A
# wrapper script would satisfy `make test` while hiding Chez from Valgrind:
# valgrind traces the shell, the shell execs Chez, and `make test-memory`
# passes having instrumented nothing (found exactly so, with a `chez`
# wrapper: 21 suites, no ERROR SUMMARY). An instrumented run always prints
# one.
case "${CHEZ:-}" in
  "$GUIX_ENVIRONMENT"/*) echo "check-guix: ok chez-variable ($CHEZ)" ;;
  *) echo "check-guix: FAILED chez-variable: CHEZ is '${CHEZ:-unset}', expected under $GUIX_ENVIRONMENT" >&2
     fail=1 ;;
esac
if valgrind "${CHEZ:-chez}" --version 2>&1 | grep -q 'ERROR SUMMARY'; then
  echo "check-guix: ok valgrind-instruments-chez"
else
  echo "check-guix: FAILED valgrind-instruments-chez: valgrind ${CHEZ:-chez} --version printed no ERROR SUMMARY" >&2
  fail=1
fi
# ...and a summary alone is not enough: a wrapper that runs Chez WITHOUT
# exec keeps the shell under Valgrind, which then prints the shell's
# summary while Chez runs uninstrumented. $(CHEZ) must be the ELF itself.
magic=$(head -c 4 "${CHEZ:-chez}" 2>/dev/null | od -An -tx1 | tr -d ' \n')
if [ "$magic" = 7f454c46 ]; then
  echo "check-guix: ok chez-is-elf"
else
  echo "check-guix: FAILED chez-is-elf: ${CHEZ:-chez} starts with '${magic:-nothing}', not an ELF header" >&2
  fail=1
fi

# Assertion 4: ssh and gpg can use the shared credentials. Both refuse a
# group- or world-writable directory, and guix creates these as 1777/0775
# (scripts/guix-env-init fixes them).
for d in "$HOME" "$HOME/.ssh" "$HOME/.gnupg" "/run/user/$(id -u)/gnupg"; do
  if [ -d "$d" ]; then
    m=$(stat -c %a "$d")
    if [ "$m" = 700 ]; then
      echo "check-guix: ok credential-dir-modes ($d: $m)"
    else
      echo "check-guix: FAILED credential-dir-modes: $d is $m, expected 700" >&2
      fail=1
    fi
  fi
done

if ! make check-pins test check-purity check-install examples check-site; then
  echo "check-guix: FAILED make-targets" >&2
  fail=1
fi

rm -f "$out"
if [ "$fail" -eq 0 ]; then
  echo "check-guix: ALL CHECKS PASSED"
fi
exit "$fail"
